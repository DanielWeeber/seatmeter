# seatmeter: Umgebung für deploy/compose.yml. Kopieren nach deploy/.env, chmod 600, Werte setzen. Nie committen.
# Datenbank-Passwort (nur [A-Za-z0-9], steht in DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=
# 32 Byte, Base64 oder Hex: openssl rand -base64 32
# Verschlüsselt die Mandanten-Salts. Getrennt sichern: ohne diesen Schlüssel sind Pseudonyme nicht reproduzierbar.
SEATMETER_MASTER_KEY=
LOG_LEVEL=info
# Öffentliche Basis-URL des Dashboards (für Links und den Agenten)
SEATMETER_PUBLIC_URL=https://seatmeter.example.org
# Nur hinter einem vertrauenswürdigen Proxy (z. B. Authelia forward_auth), der diesen Header immer selbst setzt:
# SEATMETER_TRUST_REMOTE_USER_HEADER=Remote-Email
# Mandant, dem Proxy-Benutzer ohne eigenes Konto zugeordnet werden (Slug):
# SEATMETER_AUTO_MANDANT=meine-firma
# Optional: Plugins (ee, nur mit Lizenz)
# SEATMETER_PLUGINS=
